# SPS Document Demo 로그 로테이션 설정
# 목적: web/document_demo_app.py(sps-document-demo.service)의 StandardOutput/StandardError가
#       같은 파일(document_demo_app.log)에 계속 append되어 197만 줄까지 쌓였던 문제 재발 방지.
# 주의: copytruncate를 반드시 사용한다. systemd 유닛이 파일을 열어둔 채로 append하므로,
#       일반 rotate(이름 바꾸고 새 파일 생성)는 서비스 재시작 전까지 로그가 끊겨 보일 수 있다.
#       copytruncate는 내용을 복사한 뒤 원본 파일을 그 자리에서 비워 fd를 그대로 재사용한다.
/data/vm_project/output/document_demo_app.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    maxsize 50M
    size 50M
}
