[Unit]
Description=FastAPI Gemini Tavily LangGraph Agent
After=network.target

[Service]
Type=simple
User=jeaje
Group=jeaje
WorkingDirectory=/data/vm_project/FastAPI/LangGraph
ExecStart=/data/vm_project/venv/bin/python -m uvicorn langgraph_fastapi_server:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
